APP_NAME=PTT Alert Hub
ENVIRONMENT=production
TIMEZONE=Asia/Taipei

ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=系統管理員
ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

POSTGRES_DB=ptt_alert_hub
POSTGRES_USER=ptt_alert_hub
POSTGRES_PASSWORD=change-me-database-password
# Zeabur 等平台請改成平台提供的 PostgreSQL 連線字串。
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PTT_BASE_URL=https://www.ptt.cc
PTT_REQUEST_DELAY_SECONDS=2.0
PTT_TIMEOUT_SECONDS=15
CRAWL_LOCK_TTL_SECONDS=1800

WORKER_SYNC_SECONDS=10
WORKER_LEASE_TTL_SECONDS=30
WORKER_HEARTBEAT_TIMEOUT_SECONDS=45

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend Nginx 反向代理。Docker Compose 已在 compose 內設定；Zeabur 請填 Backend 私有主機名稱。
BACKEND_HOST=backend
BACKEND_PORT=8000
